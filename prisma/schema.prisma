generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([userId, provider])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id             String       @id @default(cuid())
  name           String?
  email          String?      @unique
  emailVerified  DateTime?
  image          String?
  /// Optional bcrypt hash. Set after the user opts into password-based
  /// sign-in alongside the email-OTP path. NULL for users who only use
  /// the OTP flow. Hash includes salt; verify with bcrypt.compare.
  passwordHash   String?
  plan           Plan         @default(FREE)
  role           Role         @default(USER)
  stripeId       String?      @unique
  accounts       Account[]
  sessions       Session[]
  channels       Channel[]
  projects       Project[]
  assets         Asset[]
  designFolders  DesignFolder[]
  ownedTeams     Team[]       @relation("teamOwner")
  teamMembers    TeamMember[]
  teamActivity   TeamActivityLog[] @relation("teamActivityActor")
  aiUsage        Int          @default(0)
  aiResetAt      DateTime     @default(now())
  onboardingDone   Boolean      @default(false)
  referralCode     String?      @unique
  referredBy       String?
  referralEarnings   Float        @default(0)
  claimedMilestones  String[]     @default([])
  payouts          Payout[]
  thumbnailGenerations ThumbnailGeneration[]
  vpnPeer          VpnPeer?
  comments         Comment[]
  apiKeys          ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  pushSubscriptions PushSubscription[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  uploadJobs       UploadJob[]
  atlasConversations AtlasConversation[]
  atlasMessages    AtlasMessage[]
  atlasUsageDaily  AtlasUsageDaily[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([referredBy])
  @@index([plan])
  @@index([createdAt])
}

model Channel {
  id          String   @id
  title       String
  thumbnail   String?
  subscribers Int      @default(0)
  userId      String
  platform    ChannelPlatform @default(YOUTUBE)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadJobs  UploadJob[]
  externalUsers ExternalUser[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([platform])
}

model Project {
  id            String        @id @default(cuid())
  title         String        @default("Untitled")
  description   String?       @db.Text
  tags          String[]
  thumbnailUrl  String?
  thumbnailData Json?
  characters    Json?
  status        ProjectStatus @default(DRAFT)
  isPublic      Boolean       @default(false)
  likesCount    Int           @default(0)
  scenes        Scene[]
  comments      Comment[]
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId        String?
  team          Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, updatedAt])
  @@index([teamId])
  @@index([createdAt])
  @@index([isPublic, createdAt])
  @@index([isPublic, likesCount])
}

model Scene {
  id        String      @id @default(cuid())
  prompt    String?     @db.Text
  label     String      @default("")
  duration  Int         @default(5)
  order     Int
  status    SceneStatus @default(EMPTY)
  model     String      @default("standard")
  videoUrl  String?
  metadata  Json?
  taskId    String?
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([projectId])
  @@index([projectId, order])
  @@index([taskId])
  @@index([status])
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  STUDIO
}

enum ProjectStatus {
  DRAFT
  RENDERING
  READY
  PUBLISHED
}

enum SceneStatus {
  EMPTY
  EDITING
  GENERATING
  READY
  ERROR
}

enum TeamRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Team {
  id           String            @id @default(cuid())
  name         String
  ownerId      String
  owner        User              @relation("teamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  projects     Project[]
  activityLogs TeamActivityLog[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([ownerId])
}

model TeamMember {
  id       String   @id @default(cuid())
  role     TeamRole @default(EDITOR)
  pending  Boolean  @default(false)
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamActivityLog {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation("teamActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  action    String   // "member_invited", "member_removed", "role_changed", "project_shared", "project_unshared", "team_created"
  targetId  String?  // userId or projectId depending on action
  meta      String?  // JSON string with extra details (e.g. role, email)
  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
  @@index([actorId])
}

model Asset {
  id        String        @id @default(cuid())
  url       String
  filename  String
  type      String        @default("image")
  size      Int           @default(0)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    DesignFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([userId, folderId])
  @@index([userId, createdAt])
  @@index([folderId])
}

model DesignFolder {
  id        String         @id @default(cuid())
  name      String
  parentId  String?
  parent    DesignFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  DesignFolder[] @relation("FolderTree")
  assets    Asset[]
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
  @@index([userId, parentId])
  @@index([parentId])
}

/// Tracks already-processed Stripe webhook events for idempotency.
/// Rows older than 90 days can be safely purged via scheduled cleanup:
///   DELETE FROM "ProcessedEvent" WHERE "createdAt" < NOW() - INTERVAL '90 days';
model ProcessedEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model Payout {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  method        String   @default("manual") // "manual", "stripe_connect", "paypal"
  note          String?
  stripeEventId String?  @unique // Dedup key for Stripe webhook retries
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model VpnPeer {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey       String
  encryptedPrivKey String   @db.Text
  assignedIp      String    @unique
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  @@index([userId])
  @@index([active])
}

model ThumbnailGeneration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt      String   @db.Text
  style       String   @default("realistic")
  format      String   @default("16:9")
  imageUrl    String
  parentId    String?
  parent      ThumbnailGeneration?  @relation("ThumbnailVersions", fields: [parentId], references: [id], onDelete: SetNull)
  children    ThumbnailGeneration[] @relation("ThumbnailVersions")
  youtubeUrl  String?
  photoUrl    String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, parentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([ipAddress])
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  sceneId   String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([userId])
}

model ApiKey {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  keyHash         String    @unique
  prefix          String
  lastUsed        DateTime?
  usageCount      Int       @default(0)
  /// Quota system — uploads-per-month soft cap to prevent abuse.
  /// Reset by /api/cron/cleanup nightly when quotaResetAt < now - 30d.
  monthlyQuota    Int       @default(1000)
  monthlyUsage    Int       @default(0)
  quotaResetAt    DateTime  @default(now())
  /// Revocation marker — middleware rejects calls when set.
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  uploadJobs      UploadJob[]
  externalUsers   ExternalUser[]

  @@index([userId])
  @@index([keyHash])
}

/// External end-user belonging to an integrating organization.
/// Lets API callers (e.g., Lucky Team) onboard their own users into
/// TubeForge OAuth without exposing them as TubeForge accounts.
/// Each external user can link one OAuth-granted YouTube channel.
model ExternalUser {
  id              String   @id @default(cuid())
  apiKeyId        String
  apiKey          ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  /// Opaque ID set by the integrating org (e.g., "maker_42"). Unique
  /// per ApiKey so the same org can reuse the same maker ID without
  /// risk of cross-org collision.
  externalUserId  String
  displayName     String?
  /// FK to the standard NextAuth Account row holding youtube.upload
  /// scoped tokens. Allows reuse of getYouTubeToken() helper.
  oauthAccountId  String?
  channelId       String?
  channel         Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  uploadJobs      UploadJob[]
  createdAt       DateTime @default(now())

  @@unique([apiKeyId, externalUserId])
  @@index([apiKeyId])
  @@index([channelId])
}

enum UploadJobStatus {
  QUEUED
  UPLOADING
  COMPLETED
  FAILED
  CANCELLED
}

enum UploadSource {
  WEB_UI
  API
}

enum ChannelPlatform {
  YOUTUBE
  TIKTOK
  INSTAGRAM
}

/// Async upload job — populated when /preview or /api/v1/youtube/upload
/// creates an upload request. Worker route /api/cron/youtube-upload-processor
/// picks it up, performs server-side video fetch + PUT to YouTube,
/// updates status, and calls deliverWebhooks() on terminal states.
model UploadJob {
  id                String          @id @default(cuid())

  // Billing & identity
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId          String?
  apiKey            ApiKey?         @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  externalUserId    String?
  externalUser      ExternalUser?   @relation(fields: [externalUserId], references: [id], onDelete: SetNull)
  source            UploadSource    @default(WEB_UI)

  // Target
  channelId         String
  channel           Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  targetPlatform    ChannelPlatform @default(YOUTUBE)

  // Source video
  videoUrl          String          @db.Text
  thumbnailUrl      String?         @db.Text

  // Metadata
  title             String
  description       String?         @db.Text
  tags              String[]        @default([])
  privacyStatus     String          @default("private")
  scheduledAt       DateTime?

  // Gateway batch + idempotency (Phase 1)
  idempotencyKey    String?         @db.VarChar(120)
  consumerRef       String?         @db.VarChar(120)
  metadata          Json?

  // State
  status            UploadJobStatus @default(QUEUED)
  youtubeVideoId    String?
  errorMessage      String?         @db.Text
  retryCount        Int             @default(0)
  uploadProgress    Int             @default(0)

  // Cached webhook delivery state for /jobs UI
  webhookDelivered  Boolean         @default(false)
  webhookFailed     Boolean         @default(false)

  // Worker bookkeeping — `lockedBy` is a UUID-like worker identifier
  // set during atomic claim. Prevents double-processing if multiple
  // workers race.
  lockedBy          String?
  lockedAt          DateTime?

  // Timestamps
  createdAt         DateTime        @default(now())
  startedAt         DateTime?
  completedAt       DateTime?

  @@index([userId, createdAt])
  @@index([status, scheduledAt])
  @@index([apiKeyId, createdAt])
  @@index([channelId, createdAt])
  @@index([externalUserId])
  @@index([consumerRef])
  @@index([targetPlatform, status])
}

model WebhookEndpoint {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url        String
  events     String[]
  secret     String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  deliveries WebhookDelivery[]

  @@index([userId])
}

/// Per-delivery log for webhook observability. Each attempt to POST a
/// signed payload to a WebhookEndpoint creates a row here, success or
/// failure. UI in Settings → Integrations → Webhooks reads from this
/// to show recent activity + per-delivery retry button.
///
/// Capped at ~100 rows per webhook by a daily cleanup sweep.
model WebhookDelivery {
  id           String          @id @default(cuid())
  webhookId    String
  webhook      WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  /// Full JSON payload that was sent. Stored verbatim so retry can
  /// re-send the exact same bytes — preserves HMAC determinism.
  payload      String          @db.Text
  signature    String
  /// HTTP status returned by the receiving endpoint. NULL when the
  /// request failed at the network layer (timeout / DNS / TCP reset).
  statusCode   Int?
  /// First 2 KB of response body — useful for debugging "what did my
  /// endpoint say". Truncated to bound storage.
  responseBody String?         @db.Text
  attempt      Int             @default(1)
  success      Boolean         @default(false)
  errorMessage String?         @db.Text
  deliveredAt  DateTime?
  createdAt    DateTime        @default(now())

  @@index([webhookId, createdAt])
  @@index([webhookId, success])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("info")
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

/// Atlas — conversational AI assistant on /publish/autopilot.
/// One conversation = one thread of user↔assistant messages.
model AtlasConversation {
  id        String         @id @default(cuid())
  userId    String
  /// First user message truncated to 60 chars. Set lazily after first turn.
  title     String?
  archived  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AtlasMessage[]

  @@index([userId, updatedAt(sort: Desc)])
}

/// One turn (user OR assistant). `content` stores the full Claude turn
/// as JSON — text blocks, tool_use blocks, and tool_result blocks — so
/// the next /api/atlas/chat call can replay context verbatim.
model AtlasMessage {
  id             String   @id @default(cuid())
  conversationId String
  /// Denormalized for fast user-scoped queries and rate-limit reads.
  userId         String
  /// 'user' | 'assistant'.
  role           String
  /// Anthropic content block array: text + tool_use + tool_result.
  content        Json
  /// { input, output, cache_read, cache_write } — assistant turns only.
  usage          Json?
  createdAt      DateTime @default(now())

  conversation   AtlasConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

/// Daily token spend per user. Used by the rate-limit / budget guard
/// in /api/atlas/chat to reject requests once a user hits their tier
/// cap. Resets at UTC midnight (compound PK on userId+date).
model AtlasUsageDaily {
  userId       String
  date         DateTime @db.Date
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cacheReads   Int      @default(0)

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@index([date])
}
